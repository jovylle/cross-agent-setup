{
  "mcpServers": {
    "shared-memory": {
      "type": "local",
      "command": "/ABSOLUTE/PATH/TO/node",
      "args": ["/ABSOLUTE/PATH/TO/ecc-universal/scripts/memory-mcp.mjs"],
      "tools": ["*"],
      "env": {
        "ECC_MEMORY_HARNESS": "copilot",
        "ECC_MEMORY_ALLOW_USER_SCOPE": "1",
        "ECC_MEMORY_USER_ROOT": "/ABSOLUTE/PATH/TO/HOME/.shared-memory/memory"
      }
    }
  }
}
